{
  "schema": "pcc.gui.declarative.v1",
  "abi_version": 1,
  "byte_order": "little",
  "pointer_bytes": 8,
  "alignment_bytes": 8,
  "limits": {
    "descriptor_capacity": 1024,
    "update_capacity": 4096,
    "effect_capacity": 2048,
    "listener_capacity": 2048,
    "command_capacity": 1024,
    "style_operation_capacity": 64,
    "candidate_bytes": 256,
    "component_state_slots": 64
  },
  "slot_kinds": [
    {"id": 1, "name": "i64", "traced": false, "actions": ["set", "reduce"]},
    {"id": 2, "name": "opaque_handle", "traced": false, "actions": ["set"], "ownership": "one explicit retain per queue or base-queue record"},
    {"id": 3, "name": "managed_ref", "traced": true, "actions": ["set"], "admission": "requires retain/release, write barrier, root registration, trace and relocation update"}
  ],
  "records": [
    {
      "name": "PccGuiRenderContextV1",
      "size": 80,
      "align": 8,
      "owner": "caller",
      "fields": [
        {"name": "abi_version", "offset": 0, "type": "u32", "ownership": "value"},
        {"name": "flags", "offset": 4, "type": "u32", "ownership": "value"},
        {"name": "component_id", "offset": 8, "type": "u64", "ownership": "value"},
        {"name": "props", "offset": 16, "type": "ptr", "ownership": "borrowed for callback"},
        {"name": "props_count", "offset": 24, "type": "u32", "ownership": "value"},
        {"name": "state", "offset": 32, "type": "ptr", "ownership": "borrowed for callback"},
        {"name": "state_count", "offset": 40, "type": "u32", "ownership": "value"},
        {"name": "descriptor_arena", "offset": 48, "type": "ptr", "ownership": "caller-owned writable for callback"},
        {"name": "descriptor_capacity", "offset": 56, "type": "u32", "ownership": "value"},
        {"name": "descriptor_count_out", "offset": 64, "type": "ptr", "ownership": "caller-owned writable u32"},
        {"name": "error_out", "offset": 72, "type": "ptr", "ownership": "caller-owned writable PccGuiErrorV1"}
      ]
    },
    {
      "name": "PccGuiDescriptorV1",
      "size": 72,
      "align": 8,
      "owner": "descriptor_arena caller",
      "fields": [
        {"name": "parent_component_id", "offset": 0, "type": "u64", "ownership": "value"},
        {"name": "key", "offset": 8, "type": "u64", "ownership": "value"},
        {"name": "node_kind", "offset": 16, "type": "u32", "ownership": "value"},
        {"name": "flags", "offset": 20, "type": "u32", "ownership": "value"},
        {"name": "property_mask", "offset": 24, "type": "u64", "ownership": "value"},
        {"name": "payload0", "offset": 32, "type": "i64", "ownership": "typed by property mask"},
        {"name": "payload1", "offset": 40, "type": "i64", "ownership": "typed by property mask"},
        {"name": "payload2", "offset": 48, "type": "i64", "ownership": "typed by property mask"},
        {"name": "payload3", "offset": 56, "type": "i64", "ownership": "typed by property mask"},
        {"name": "listener_id", "offset": 64, "type": "u64", "ownership": "registry id"}
      ],
      "identity": ["parent_component_id", "key", "node_kind"]
    },
    {
      "name": "PccGuiSlotV1",
      "size": 24,
      "align": 8,
      "owner": "component",
      "fields": [
        {"name": "kind", "offset": 0, "type": "u32", "ownership": "value"},
        {"name": "flags", "offset": 4, "type": "u32", "ownership": "value"},
        {"name": "value", "offset": 8, "type": "i64", "ownership": "according to slot kind"},
        {"name": "generation", "offset": 16, "type": "u64", "ownership": "value"}
      ]
    },
    {
      "name": "PccGuiComponentInstanceV1",
      "size": 80,
      "align": 8,
      "owner": "component registry",
      "fields": [
        {"name": "component_id", "offset": 0, "type": "u64", "ownership": "generation-bearing stable id"},
        {"name": "parent_component_id", "offset": 8, "type": "u64", "ownership": "value"},
        {"name": "root_node_id", "offset": 16, "type": "u64", "ownership": "generation-bearing kernel id"},
        {"name": "render_callback_id", "offset": 24, "type": "u32", "ownership": "registry id"},
        {"name": "flags", "offset": 28, "type": "u32", "ownership": "mounted/dirty/unmounting"},
        {"name": "props", "offset": 32, "type": "ptr", "ownership": "component-owned immutable record"},
        {"name": "props_count", "offset": 40, "type": "u32", "ownership": "value"},
        {"name": "state_count", "offset": 44, "type": "u32", "ownership": "value"},
        {"name": "state", "offset": 48, "type": "ptr", "ownership": "component-owned PccGuiSlotV1 array"},
        {"name": "update_head", "offset": 56, "type": "i64", "ownership": "update arena index or -1"},
        {"name": "update_tail", "offset": 64, "type": "i64", "ownership": "update arena index or -1"},
        {"name": "generation", "offset": 72, "type": "u64", "ownership": "stale-id protection"}
      ]
    },
    {
      "name": "PccGuiUpdateV1",
      "size": 64,
      "align": 8,
      "owner": "component update queue or skipped-update base queue",
      "fields": [
        {"name": "enqueue_sequence", "offset": 0, "type": "u64", "ownership": "globally ordered value"},
        {"name": "component_id", "offset": 8, "type": "u64", "ownership": "value"},
        {"name": "lane", "offset": 16, "type": "u32", "ownership": "value"},
        {"name": "slot", "offset": 20, "type": "u32", "ownership": "value"},
        {"name": "action", "offset": 24, "type": "u32", "ownership": "SET=1 REDUCE=2"},
        {"name": "flags", "offset": 28, "type": "u32", "ownership": "value"},
        {"name": "operand", "offset": 32, "type": "i64", "ownership": "slot-kind dependent"},
        {"name": "reducer_id", "offset": 40, "type": "u32", "ownership": "registry id"},
        {"name": "retry_count", "offset": 44, "type": "u32", "ownership": "value"},
        {"name": "next_index", "offset": 48, "type": "i64", "ownership": "arena index or -1"},
        {"name": "owned_handle", "offset": 56, "type": "i64", "ownership": "one owned handle when flagged"}
      ]
    },
    {
      "name": "PccGuiEffectV1",
      "size": 48,
      "align": 8,
      "owner": "work-in-progress effect arena until atomic commit",
      "fields": [
        {"name": "sequence", "offset": 0, "type": "u64", "ownership": "value"},
        {"name": "component_id", "offset": 8, "type": "u64", "ownership": "value"},
        {"name": "node_id", "offset": 16, "type": "i64", "ownership": "kernel id"},
        {"name": "phase", "offset": 24, "type": "u32", "ownership": "value"},
        {"name": "kind", "offset": 28, "type": "u32", "ownership": "value"},
        {"name": "callback_id", "offset": 32, "type": "u32", "ownership": "registry id"},
        {"name": "flags", "offset": 36, "type": "u32", "ownership": "value"},
        {"name": "payload", "offset": 40, "type": "i64", "ownership": "callback-contract dependent"}
      ]
    },
    {
      "name": "PccGuiStateSnapshotV1",
      "size": 40,
      "align": 8,
      "owner": "component scheduler",
      "fields": [
        {"name": "component_id", "offset": 0, "type": "u64", "ownership": "value"},
        {"name": "slots", "offset": 8, "type": "ptr", "ownership": "scheduler-owned bounded PccGuiSlotV1 array"},
        {"name": "slot_count", "offset": 16, "type": "u32", "ownership": "value"},
        {"name": "flags", "offset": 20, "type": "u32", "ownership": "value"},
        {"name": "base_queue_head", "offset": 24, "type": "i64", "ownership": "update arena index or -1"},
        {"name": "base_sequence", "offset": 32, "type": "u64", "ownership": "value"}
      ]
    },
    {
      "name": "PccGuiListenerV1",
      "size": 40,
      "align": 8,
      "owner": "single component listener registry",
      "fields": [
        {"name": "listener_id", "offset": 0, "type": "u64", "ownership": "value"},
        {"name": "target_component_id", "offset": 8, "type": "u64", "ownership": "value"},
        {"name": "event_type", "offset": 16, "type": "u32", "ownership": "value"},
        {"name": "callback_id", "offset": 20, "type": "u32", "ownership": "registry id"},
        {"name": "flags", "offset": 24, "type": "u32", "ownership": "active/once"},
        {"name": "reserved", "offset": 28, "type": "u32", "ownership": "zero"},
        {"name": "policy_context", "offset": 32, "type": "i64", "ownership": "borrowed scalar or handle"}
      ]
    },
    {
      "name": "PccGuiStyleOperationV1",
      "size": 40,
      "align": 8,
      "owner": "immutable compiled style cache entry",
      "fields": [
        {"name": "utility_id", "offset": 0, "type": "u32", "ownership": "registry id"},
        {"name": "namespace_id", "offset": 4, "type": "u32", "ownership": "value"},
        {"name": "token_id", "offset": 8, "type": "u32", "ownership": "value"},
        {"name": "flags", "offset": 12, "type": "u32", "ownership": "negative/modifier flags"},
        {"name": "value", "offset": 16, "type": "i64", "ownership": "immutable scalar"},
        {"name": "namespace_generation", "offset": 24, "type": "u64", "ownership": "value"},
        {"name": "token_generation", "offset": 32, "type": "u64", "ownership": "value"}
      ]
    },
    {
      "name": "PccGuiInvokeV1",
      "size": 64,
      "align": 8,
      "owner": "command resolver until completion or cancellation",
      "fields": [
        {"name": "request_id", "offset": 0, "type": "u64", "ownership": "value"},
        {"name": "command_id", "offset": 8, "type": "u32", "ownership": "registry id"},
        {"name": "flags", "offset": 12, "type": "u32", "ownership": "sync/async"},
        {"name": "target_id", "offset": 16, "type": "u64", "ownership": "value"},
        {"name": "payload", "offset": 24, "type": "ptr", "ownership": "borrowed for callback; resolver retains if queued"},
        {"name": "payload_length", "offset": 32, "type": "u64", "ownership": "value"},
        {"name": "policy_context", "offset": 40, "type": "i64", "ownership": "borrowed scalar or handle"},
        {"name": "resolver_id", "offset": 48, "type": "u64", "ownership": "value"},
        {"name": "error_out", "offset": 56, "type": "ptr", "ownership": "caller-owned writable PccGuiErrorV1"}
      ]
    },
    {
      "name": "PccGuiStyleCacheEntryV1",
      "size": 80,
      "align": 8,
      "owner": "style compiler cache",
      "fields": [
        {"name": "key_hash", "offset": 0, "type": "u64", "ownership": "value"},
        {"name": "class_bytes", "offset": 8, "type": "ptr", "ownership": "cache-owned immutable bytes"},
        {"name": "class_length", "offset": 16, "type": "u32", "ownership": "value"},
        {"name": "flags", "offset": 20, "type": "u32", "ownership": "valid/compiling"},
        {"name": "schema_generation", "offset": 24, "type": "u64", "ownership": "value"},
        {"name": "operations", "offset": 32, "type": "ptr", "ownership": "cache-owned immutable PccGuiStyleOperationV1 array"},
        {"name": "operation_count", "offset": 40, "type": "u32", "ownership": "value"},
        {"name": "namespace_dependency_count", "offset": 44, "type": "u32", "ownership": "value"},
        {"name": "namespace_dependencies", "offset": 48, "type": "ptr", "ownership": "cache-owned generation pairs"},
        {"name": "token_dependencies", "offset": 56, "type": "ptr", "ownership": "cache-owned generation pairs"},
        {"name": "token_dependency_count", "offset": 64, "type": "u32", "ownership": "value"},
        {"name": "reserved", "offset": 68, "type": "u32", "ownership": "zero"},
        {"name": "last_used_epoch", "offset": 72, "type": "u64", "ownership": "value"}
      ]
    },
    {
      "name": "PccGuiCompletionV1",
      "size": 48,
      "align": 8,
      "owner": "resolver",
      "fields": [
        {"name": "request_id", "offset": 0, "type": "u64", "ownership": "value"},
        {"name": "kind", "offset": 8, "type": "u32", "ownership": "result/error/cancelled"},
        {"name": "status", "offset": 12, "type": "i32", "ownership": "stable error code"},
        {"name": "payload", "offset": 16, "type": "ptr", "ownership": "owned until consumer accepts"},
        {"name": "payload_length", "offset": 24, "type": "u64", "ownership": "value"},
        {"name": "message", "offset": 32, "type": "ptr", "ownership": "borrowed static diagnostic"},
        {"name": "flags", "offset": 40, "type": "u32", "ownership": "value"}
      ]
    },
    {
      "name": "PccGuiAppEventV1",
      "size": 48,
      "align": 8,
      "owner": "app event queue until callback returns",
      "fields": [
        {"name": "sequence", "offset": 0, "type": "u64", "ownership": "value"},
        {"name": "kind", "offset": 8, "type": "u32", "ownership": "value"},
        {"name": "flags", "offset": 12, "type": "u32", "ownership": "value"},
        {"name": "window_id", "offset": 16, "type": "u64", "ownership": "value"},
        {"name": "payload", "offset": 24, "type": "ptr", "ownership": "queue-owned stable copy or retained native handle"},
        {"name": "payload_length", "offset": 32, "type": "u64", "ownership": "value"},
        {"name": "exit_code", "offset": 40, "type": "i32", "ownership": "value when present"},
        {"name": "status_out", "offset": 44, "type": "i32", "ownership": "callback writes accept/cancel"}
      ]
    },
    {
      "name": "PccGuiErrorV1",
      "size": 24,
      "align": 8,
      "owner": "caller",
      "fields": [
        {"name": "code", "offset": 0, "type": "i32", "ownership": "stable error code"},
        {"name": "phase", "offset": 4, "type": "u32", "ownership": "value"},
        {"name": "subject_id", "offset": 8, "type": "u64", "ownership": "value"},
        {"name": "message", "offset": 16, "type": "ptr", "ownership": "borrowed static diagnostic"}
      ]
    }
  ],
  "callbacks": {
    "component_render": {"abi": "i32(PccGuiRenderContextV1*)", "arguments": "borrowed", "result": "descriptor count or stable negative error"},
    "reducer": {"abi": "i32(i64 old_value, i64 operand, i64* result_out)", "arguments": "borrowed scalars", "result": "ownership-free scalar", "purity": "deterministic and retryable; side effects forbidden"},
    "effect": {"abi": "i32(u64 component_id, u32 phase, i64 payload)", "arguments": "borrowed", "result": "stable status"},
    "listener": {"abi": "i32(u64 listener_id, u64 target_id, ptr event)", "arguments": "event borrowed for callback", "result": "continue=0 stop=1 error<0"},
    "command": {"abi": "i32(PccGuiInvokeV1*, u64 resolver_id)", "arguments": "invoke borrowed for callback", "result": "completed=0 queued=1 error<0"},
    "app_event": {"abi": "i32(PccGuiAppEventV1*)", "arguments": "event borrowed for callback", "result": "accept=0 cancel=1 error<0"}
  },
  "callback_registration": {
    "id_space": "u32; zero is invalid; ids are never reused before registry generation changes",
    "duplicate": "DUPLICATE_KEY",
    "unknown": "CALLBACK_FAILED",
    "teardown": "unregister only after queued work, listeners, effects and command callbacks owned by the target are cancelled"
  },
  "identity": {
    "component_id": "u64 packing generation in high 32 bits and arena index in low 32 bits",
    "node_id": "u64 packing generation in high 32 bits and kernel pool index in low 32 bits",
    "child": ["parent_component_id", "key", "node_kind"],
    "stale": "generation mismatch is STALE_NODE and never aliases a recycled record"
  },
  "lanes": [
    {"id": 0, "name": "discrete", "priority": 0, "age_ticks": 0},
    {"id": 1, "name": "animation", "priority": 1, "age_ticks": 2},
    {"id": 2, "name": "default", "priority": 2, "age_ticks": 8},
    {"id": 3, "name": "background", "priority": 3, "age_ticks": 32}
  ],
  "update_replay": {
    "ordering": "enqueue_sequence ascending across all lanes",
    "skip_rule": "snapshot state immediately before first skipped update; clone that update and every later processed update",
    "retry_rule": "reducers may run again after interruption and therefore must be pure",
    "handle_rule": "each queue/base-queue clone owns exactly one retain; cancellation and error release exactly once",
    "commit_rule": "only a complete render may mutate the committed tree"
  },
  "commit": {
    "work_owner": "caller-owned descriptor and effect arenas",
    "rollback": "discard all work arenas and leave the committed tree, owner map, focus and hover unchanged",
    "atomicity": "validate complete descriptor/effect sets and capacities before first kernel mutation",
    "removal": "destroy subtree, remove node-owner routes, listener routes, focus and hover before recycling ids"
  },
  "routing": {
    "path_owner": "kernel returns painted hit leaf plus complete leaf-to-root ancestor node path",
    "dispatch_owner": "component listener registry alone maps node owners and dispatches target then bubble",
    "capture": "not selected in v1",
    "legacy": "pcc_kit_route_event must be version-superseded and may not dispatch in parallel"
  },
  "effect_phases": [
    {"id": 0, "name": "before_mutation_snapshot"},
    {"id": 1, "name": "mutation_layout_cleanup"},
    {"id": 2, "name": "mutation_structural"},
    {"id": 3, "name": "layout_create"},
    {"id": 4, "name": "passive_cleanup"},
    {"id": 5, "name": "passive_create"}
  ],
  "style": {
    "namespaces": ["colour", "font", "size", "spacing"],
    "candidate_grammar": "candidate := ['-'] utility '-' value [ '/' (identifier | '[' arbitrary ']') ]; class_string := candidate *(SP candidate)",
    "negative_policy": "registered per utility and distinct from slash modifier",
    "cache_key": ["class_string", "schema_generation", "referenced_namespace_generations", "referenced_token_generations"],
    "warm_apply": "no parsing and no allocation"
  },
  "state_machines": {
    "render_work": {
      "initial": "idle",
      "terminal": ["committed", "failed", "cancelled"],
      "transitions": [
        ["idle", "rendering"], ["rendering", "yielded"], ["yielded", "rendering"],
        ["rendering", "ready_to_commit"], ["ready_to_commit", "committing"],
        ["committing", "committed"], ["rendering", "failed"],
        ["ready_to_commit", "failed"], ["rendering", "cancelled"],
        ["yielded", "cancelled"]
      ]
    },
    "command_completion": {
      "initial": "pending",
      "terminal": ["result", "error", "cancelled"],
      "transitions": [["pending", "result"], ["pending", "error"], ["pending", "cancelled"]]
    },
    "app": {
      "initial": "created",
      "terminal": ["exited"],
      "transitions": [
        ["created", "ready"], ["ready", "resumed"], ["resumed", "active"],
        ["active", "active"], ["active", "exit_requested"],
        ["exit_requested", "active"], ["exit_requested", "terminating"],
        ["terminating", "exited"]
      ],
      "events": ["Ready", "Resumed", "MainEventsCleared", "WindowEvent", "Opened", "Reopen", "ExitRequested", "Exit"],
      "rules": [
        "MainEventsCleared drains scheduled UI work before layout and render",
        "one ExitRequested may be cancelled before one accepted request",
        "accepted exit cancels commands/listeners, runs all cleanup, releases native handles, then emits Exit exactly once",
        "WebviewEvent is excluded"
      ]
    }
  },
  "errors": [
    {"code": 0, "name": "OK"},
    {"code": -100, "name": "ABI_VERSION"},
    {"code": -101, "name": "CAPACITY"},
    {"code": -102, "name": "DUPLICATE_KEY"},
    {"code": -103, "name": "INVALID_TRANSITION"},
    {"code": -104, "name": "REDUCER_FAILED"},
    {"code": -105, "name": "OWNERSHIP"},
    {"code": -106, "name": "STALE_NODE"},
    {"code": -107, "name": "DUPLICATE_COMPLETION"},
    {"code": -108, "name": "LATE_COMPLETION"},
    {"code": -109, "name": "CANCELLED"},
    {"code": -110, "name": "UNKNOWN_COMMAND"},
    {"code": -111, "name": "POLICY_DENIED"},
    {"code": -112, "name": "INVALID_PAYLOAD"},
    {"code": -113, "name": "INVALID_CANDIDATE"},
    {"code": -114, "name": "AMBIGUOUS_CANDIDATE"},
    {"code": -115, "name": "TEARDOWN"},
    {"code": -116, "name": "CALLBACK_FAILED"}
  ],
  "nonclaims": [
    "No upstream React, Tailwind or Tauri wire/API compatibility",
    "No WebviewEvent or webview runtime",
    "No managed_ref admission without GC0..4 trace/update evidence",
    "No runtime GUI implementation is claimed by this contract artifact"
  ]
}
